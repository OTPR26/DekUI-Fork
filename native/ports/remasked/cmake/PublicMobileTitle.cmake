option(REMASKED_PUBLIC_MOBILE "Build a public mobile package from reviewed title sources" OFF)
set(REMASKED_PUBLIC_TITLE_DIR "" CACHE PATH "Reviewed translated title source directory")
set(REMASKED_PUBLIC_TITLE_MANIFEST_SHA256 "" CACHE STRING "Pinned manifest digest for the reviewed title sources")

function(remasked_check_public_title directory expected_hash)
  if(NOT expected_hash MATCHES "^[a-f0-9]+$")
    message(FATAL_ERROR "A reviewed public title manifest digest is required")
  endif()
  string(LENGTH "${expected_hash}" hash_length)
  if(NOT hash_length EQUAL 64)
    message(FATAL_ERROR "A reviewed public title manifest digest is required")
  endif()
  set(manifest "${directory}/TITLE_SOURCE_MANIFEST.json")
  if(NOT IS_DIRECTORY "${directory}" OR IS_SYMLINK "${directory}" OR
      NOT EXISTS "${manifest}" OR IS_SYMLINK "${manifest}")
    message(FATAL_ERROR "A regular public title manifest is required")
  endif()
  file(SHA256 "${manifest}" actual_hash)
  if(NOT actual_hash STREQUAL expected_hash)
    message(FATAL_ERROR "Public title manifest digest does not match the reviewed input")
  endif()
  file(READ "${manifest}" metadata)
  string(JSON local_type ERROR_VARIABLE local_missing TYPE "${metadata}" local_only)
  if(NOT local_missing)
    string(JSON local_only GET "${metadata}" local_only)
    if(NOT local_type STREQUAL "BOOLEAN" OR local_only)
      message(FATAL_ERROR "Local-only title inputs cannot be used in a public package")
    endif()
  endif()
  file(GLOB entries RELATIVE "${directory}" "${directory}/*")
  foreach(entry IN LISTS entries)
    if(entry STREQUAL "TITLE_SOURCE_MANIFEST.json")
      continue()
    endif()
    if(NOT entry MATCHES "^[A-Za-z0-9_]+\\.(cpp|h)$" OR
        IS_DIRECTORY "${directory}/${entry}" OR IS_SYMLINK "${directory}/${entry}")
      message(FATAL_ERROR "Unexpected file in public title input: ${entry}")
    endif()
    string(JSON digest ERROR_VARIABLE missing GET "${metadata}" files "${entry}")
    if(missing)
      message(FATAL_ERROR "Unlisted file in public title input: ${entry}")
    endif()
  endforeach()
endfunction()
