+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include "core/arm/fastinterp/remasked_inventory_options.h"
+#include "core/arm/fastinterp/remasked_presentation_values.h"
+#include "mm3d/inventory_shadow.h"
+#include "mm3d/world_map_prompt.h"
+#include "core/arm/fastinterp/pause_arrow_hints.h"
+
+namespace Core::FastInterp {
+
+inline void ApplyRemaskedPausePresentation() {
+    using namespace MM3D;
+    using NativeInventory::ButtonPose;
+    const auto value = PresentationValue;
+    const auto pose = [&](std::string_view prefix, auto previous) {
+        const std::string key(prefix);
+        return decltype(previous){value(key + "_x", previous.x), value(key + "_y", previous.y),
+                                  value(key + "_scale", previous.scale)};
+    };
+
+    InventoryMenu::Options inventory;
+    const auto panel = pose("inventory_panel", ButtonPose{inventory.x, inventory.y, inventory.scale});
+    inventory.x = panel.x;
+    inventory.y = panel.y;
+    inventory.scale = panel.scale;
+    const auto masks = pose("inventory_masks", ButtonPose{});
+    inventory.masks_x = masks.x;
+    inventory.masks_y = masks.y;
+    inventory.masks_scale = masks.scale;
+    const auto bar = pose("inventory_bar", ButtonPose{});
+    inventory.bar_x = bar.x;
+    inventory.bar_y = bar.y;
+    inventory.bar_scale = bar.scale;
+    inventory.bar_spacing = value("inventory_bar_spacing", inventory.bar_spacing);
+    const auto description = pose("inventory_description", ButtonPose{});
+    inventory.description_x = description.x;
+    inventory.description_y = description.y;
+    inventory.description_scale = description.scale;
+    const auto model = pose("inventory_model", ButtonPose{});
+    inventory.model_x = model.x;
+    inventory.model_y = model.y;
+    inventory.model_scale = model.scale;
+    inventory.background = pose("inventory_background", ButtonPose{});
+    inventory.background.y = value("brown_background_y", inventory.background.y);
+    inventory.background.scale = value("brown_background_scale", inventory.background.scale);
+    inventory.shadow_width = value("brown_shadow_width", inventory.shadow_width);
+    inventory.shadow_opacity = value("brown_shadow_opacity", inventory.shadow_opacity);
+    inventory.gear_button = pose("inventory_button_gear", ButtonPose{});
+    inventory.help.pose = pose("inventory_help_0", inventory.help.pose);
+    inventory.help.horizontal = value("inventory_help_horizontal", inventory.help.horizontal) != 0;
+    inventory.help.spacing = value("inventory_help_spacing", inventory.help.spacing);
+    inventory.help.button_gap = value("inventory_help_button_gap", inventory.help.button_gap);
+    inventory.help.button_scale = value("inventory_help_button_scale", inventory.help.button_scale);
+    inventory.help.text_scale = value("inventory_help_text_scale", inventory.help.text_scale);
+    inventory.map_prompt = pose("inventory_map_prompt", inventory.map_prompt);
+    constexpr std::array<std::string_view, 3> tabs{"back", "masks", "items"};
+    constexpr std::array<std::string_view, 3> prompt_parts{"r", "arrow", "text"};
+    for (unsigned i = 0; i < tabs.size(); ++i) {
+        inventory.buttons[i] = pose(std::string("inventory_button_") + std::string(tabs[i]), ButtonPose{});
+        inventory.map_prompt_elements[i] = pose(std::string("inventory_map_prompt_") +
+            std::string(prompt_parts[i]), inventory.map_prompt_elements[i]);
+    }
+    for (unsigned i = 0; i < GearMenu::Count; ++i)
+        inventory.gear.poses[i] = pose("gear_" + std::to_string(i), inventory.gear.poses[i]);
+    InventoryMenu::Apply(inventory);
+
+    DungeonMap::Options map;
+    for (unsigned i = 0; i < DungeonMap::Count; ++i)
+        map.poses[i] = pose("dungeon_map_" + std::to_string(i), map.poses[i]);
+    for (unsigned i = 0; i < map.panels.size(); ++i)
+        map.panels[i] = pose("dungeon_map_panel_" + std::to_string(i), map.panels[i]);
+    map.top_panel = pose("dungeon_map_top_panel", map.top_panel);
+    map.panel_darkness = value("dungeon_map_panel_darkness", map.panel_darkness);
+    DungeonMap::Apply(map);
+
+    NativeNotebook::Options notebook;
+    for (unsigned i = 0; i < NativeNotebook::Count; ++i)
+        notebook.poses[i] = pose("notebook_live_" + std::to_string(i), notebook.poses[i]);
+    notebook.map_prompt_y = value("notebook_map_prompt_y", notebook.map_prompt_y);
+    NativeNotebook::Apply(notebook);
+
+    NativeItemPresent::Options present;
+    for (unsigned i = 0; i < NativeItemPresent::Count; ++i)
+        present.poses[i] = pose("item_present_" + std::to_string(i), present.poses[i]);
+    present.horizontal = value("item_present_horizontal", present.horizontal) != 0;
+    NativeItemPresent::Apply(present);
+    auto mask = present;
+    mask.horizontal = false;
+    for (unsigned i = 0; i < NativeItemPresent::Count; ++i)
+        mask.poses[i] = pose("mask_present_" + std::to_string(i), mask.poses[i]);
+    NativeItemPresent::ApplyMask(mask);
+
+    ItemsMapPrompt::ReturnOptions returning;
+    returning.pose = pose("map_items_prompt", returning.pose);
+    for (unsigned i = 0; i < prompt_parts.size(); ++i) {
+        const auto part = i == 0 ? std::string_view{"l"} : prompt_parts[i];
+        returning.elements[i] = pose("map_items_prompt_" + std::string(part), returning.elements[i]);
+    }
+    ItemsMapPrompt::ApplyReturn(returning);
+    WorldMapPrompt::Apply(pose("world_map_zoom_prompt", ButtonPose{0, 0, .8f}));
+}
+
+struct RemaskedPauseDraw {
+    MM3D::NativeItemPresent::Hook present;
+    MM3D::InventoryShadow::Hook shadow;
+    MM3D::ItemsMapPrompt::Hook items_map;
+    MM3D::PauseArrowHints::Hook map_items, map_notebook, notebook_map;
+    MM3D::MenuTabs::Hook tabs;
+    MM3D::MenuHelp::Hook help{.direct_item_bumpers = true};
+    MM3D::MenuHelp::Hook select_help;
+    MM3D::WorldMapPrompt::Hook zoom;
+    MM3D::DialogueScale::Hook dialogue;
+
+    template<class Memory> void BeginDual(Memory& memory, MM3D::NativeInventory::Hook& inventory,
+                                          u32 layout, bool lower) {
+        using MM3D::NativeInventory::Pointer;
+        auto& writes = fit_frames.emplace_back();
+        std::vector<u32> panes;
+        std::vector<u32> pending{layout + 8};
+        // A standalone lower HUD entry may contain an embedded item set.
+        // Walk its submitted panes without requiring an entire tree to be
+        // transformable or assuming the name of the enclosing layout.
+        while (!pending.empty() && panes.size() < 1024) {
+            const u32 pane = pending.back();
+            pending.pop_back();
+            if (!Pointer(pane, 0x140) || std::find(panes.begin(), panes.end(), pane) != panes.end()) continue;
+            panes.push_back(pane);
+            if (auto embedded = memory.Read(pane + 0x20).value_or(0); Pointer(embedded, 0x148)) {
+                pending.push_back(embedded + 8);
+                continue;
+            }
+            if (const auto group = memory.Read(pane + 0x24).value_or(0xffff) & 0xffff; group != 0xffff) {
+                const auto owner = memory.Read(pane + 4).value_or(0);
+                if (!Pointer(owner, 0x14c)) continue;
+                const auto groups = memory.Read(owner + 0x144).value_or(0);
+                const auto count = memory.Read(owner + 0x148).value_or(0);
+                if (group < count && count <= 1024 && Pointer(groups, 4*count))
+                    if (auto child = memory.Read(groups + 4*group).value_or(0); Pointer(child, 0x144))
+                        pending.push_back(child + 4);
+                continue;
+            }
+            const auto list = memory.Read(pane + 0x14).value_or(0);
+            const auto count = memory.Read(pane + 0x18).value_or(0);
+            if (!count || count > 256 || !Pointer(list, 4*count)) continue;
+            for (u32 i = 0; i < count; ++i) pending.push_back(memory.Read(list + i*4).value_or(0));
+        }
+        UpdateItemSlotLabels(memory, inventory, panes, writes, lower);
+        for (const auto& write : writes) memory.Write(write.address, write.after);
+    }
+
+    template<class Memory> void EndDual(Memory& memory) {
+        if (fit_frames.empty()) return;
+        for (auto it = fit_frames.back().rbegin(); it != fit_frames.back().rend(); ++it)
+            memory.Write(it->address, it->before);
+        fit_frames.pop_back();
+    }
+
+    template<class Memory>
+    u32 Root(Memory& memory, MM3D::NativeInventory::Hook& inventory,
+             MM3D::ItemPreview::Hook& preview, MM3D::DungeonMap::Hook& map,
+             MM3D::NativeNotebook::Hook& notebook,
+             u32 layout, u32 stack, u32 root, std::int64_t guest_us) {
+        const u32 original = layout + 8;
+        const auto push = [&] { return root == original ? stack : root; };
+
+        if (root == original) root = shadow.Root(memory, inventory, layout, push(), &present);
+        else shadow.scratch.frames.emplace_back();
+        items_map.ResolveDescription(memory, preview.owner, inventory.panel);
+        root = items_map.Root(memory, inventory, layout, push(), root, false, guest_us);
+        if (root == original) root = map.PromptRoot(memory, layout, push(), false);
+        else map.map_prompts.scratch.frames.emplace_back();
+        if (root == original) root = map.PanelRoot(memory, layout, push());
+        else map.panel_scratch.frames.emplace_back();
+        if (root == original) root = map.ShadowRoot(memory, layout, push());
+        else map.shadow_scratch.frames.emplace_back();
+        root = map_items.MapRoot(memory, map, layout, push(), root, false, guest_us);
+        root = map_notebook.MapRoot(memory, map, layout, push(), root, false, guest_us, true);
+        root = notebook_map.NotebookRoot(memory, notebook, layout, push(), root, false, guest_us);
+        root = zoom.Root(memory, map, layout, push(), root, false);
+        root = tabs.Root(memory, inventory, layout, push(), root);
+        help.source.ResolveDescription(memory, preview.owner, inventory.panel);
+        root = help.Root(memory, inventory, layout, push(), root);
+        if (!present.IsDescription(memory, select_help.source.description))
+            select_help.source.description = 0;
+        root = select_help.Root(memory, inventory, layout, push(), root, &present);
+        FitPausePicture(memory, inventory, preview, map, layout, root);
+        return root;
+    }
+
+    template<class Memory> void End(Memory& memory, MM3D::DungeonMap::Hook& map, u32& stack) {
+        const auto restore = [&](auto& scratch) {
+            if (const auto saved = scratch.End(memory)) stack = saved;
+        };
+        EndDual(memory);
+        restore(select_help.scratch);
+        restore(help.scratch);
+        restore(tabs.scratch);
+        restore(zoom);
+        restore(notebook_map.prompt);
+        restore(map_notebook.prompt);
+        restore(map_items.prompt);
+        restore(map.shadow_scratch);
+        restore(map.panel_scratch);
+        restore(map.map_prompts.scratch);
+        restore(items_map.prompt);
+        restore(shadow.scratch);
+    }
+
+private:
+    using Write = MM3D::NativeInventory::Hook::Write;
+    std::vector<std::vector<Write>> fit_frames;
+
+    template<class Memory> void UpdateItemSlotLabels(Memory& memory, MM3D::NativeInventory::Hook& inventory,
+                                                    const std::vector<u32>& panes, std::vector<Write>& writes,
+                                                    bool lower = false) {
+        using namespace MM3D::NativeInventory;
+        const u32 atlas = help.source.prompt.Parts(memory);
+        for (u32 pane : panes) {
+            const auto geometry = memory.Read(pane + 0x28);
+            if (!geometry || !Pointer(*geometry, 0x7c) ||
+                (memory.Read(*geometry + 4).value_or(0) & 0xffffu) != 6) continue;
+            const auto owner = memory.Read(pane + 4);
+            if (!owner || !(LayoutNamed(memory, *owner, "ItemIconSet") ||
+                            LayoutNamed(memory, *owner, "ItemIconSet2") ||
+                            (lower && LayoutNamed(memory, *owner, "HudItemIconSet")))) continue;
+            const bool left = Named(memory, pane, "disp_1_pane");
+            const bool right = Named(memory, pane, "disp_2_pane");
+            const bool face = Named(memory, pane, "disp_x_pane") || Named(memory, pane, "disp_y_pane");
+            if (!left && !right && !face) continue;
+
+            std::vector<Write> label;
+            const auto stage = [&](u32 address, u32 bits) {
+                return inventory.Stage(memory, label, address, bits);
+            };
+            const auto uv = [&](u32 address, float value) {
+                return stage(address, std::bit_cast<u32>(value));
+            };
+            if (face) {
+                // The face letters are separate from the backgrounds, item art and counters.
+                const auto flags = memory.Read(pane + 0xd4);
+                if (!flags || !stage(pane + 0xd4, *flags & ~1u)) continue;
+            } else {
+                // Reuse the same L/R sprites as the existing pause prompts.
+                // Override the label pane's native UV transform for this draw only.
+                if (!atlas || !stage(*geometry + 0x10, atlas) ||
+                    !uv(*geometry + 0x28, (left ? 176.f : 192.f) / 256) ||
+                    !uv(*geometry + 0x2c, 0.f) || !uv(*geometry + 0x30, 16.f / 256) ||
+                    !uv(*geometry + 0x34, 16.f / 128) ||
+                    !uv(pane + 0x110, 1.f) || !uv(pane + 0x114, 0.f) ||
+                    !uv(pane + 0x118, 0.f) || !uv(pane + 0x11c, 0.f) ||
+                    !uv(pane + 0x120, 1.f) || !uv(pane + 0x124, 0.f)) continue;
+            }
+            writes.insert(writes.end(), label.begin(), label.end());
+        }
+    }
+
+    template<class Memory> void FitPausePicture(Memory& memory, MM3D::NativeInventory::Hook& inventory,
+                                                MM3D::ItemPreview::Hook& preview,
+                                                MM3D::DungeonMap::Hook& map, u32 layout, u32 root) {
