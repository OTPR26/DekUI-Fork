+    u32 Rewrite(u32 pc, u32 word) {
+        using namespace MM3D;
+        if (pc == ShortcutPC && word == ShortcutWord) {
+            return MatchesTitle() && ShortcutCodeMatches() ? 0xef000000 | ShortcutSVC : word;
+        }
+        if (pc == ItemShoulderPC && word == ItemShoulderWord) {
+            return MatchesTitle() && ItemShoulderCodeMatches() ? 0xef000000 | ItemShoulderSVC : word;
+        }
+        if (const auto instruction = IOSMenuPageSwitch::Instruction(pc, word); instruction != word) {
+            return MatchesTitle() && IOSMenuPageSwitch::CodeMatches(guest) ? instruction : word;
+        }
+        if (const auto instruction = ItemPreview::Instruction(pc, word); instruction != word) {
+            return MatchesTitle() && ItemPreview::CodeMatches(guest) ? instruction : word;
+        }
+        if (const auto instruction = DungeonMap::Instruction(pc, word); instruction != word) {
+            return MatchesTitle() && DungeonMap::CodeMatches(guest) ? instruction : word;
+        }
+        if (const auto instruction = NativeNotebook::Instruction(pc, word); instruction != word) {
+            return MatchesTitle() && NativeNotebook::CodeMatches(guest) ? instruction : word;
+        }
+        if (const auto instruction = NativeNotebook::MapInstruction(pc, word); instruction != word) {
+            return MatchesTitle() && NativeNotebook::MapCodeMatches(guest) ? instruction : word;
+        }
+        if (const auto instruction = HudButtons::VisibilityInstruction(pc, word); instruction != word) {
+            return MatchesTitle() && HudButtons::VisibilityCodeMatches(guest) ? instruction : word;
+        }
+        if (const auto instruction = DialogueScale::Instruction(pc, word); instruction != word) {
+            return MatchesTitle() && DialogueScale::CodeMatches(guest) ? instruction : word;
+        }
+        if (const auto instruction = InventoryNavigation::Instruction(pc, word); instruction != word) {
+            return MatchesTitle() && InventoryNavigation::CodeMatches(guest) ? instruction : word;
+        }
+        if (const auto instruction = NativeStartup::Instruction(pc, word); instruction != word) {
+            return MatchesTitle() && NativeStartup::CodeMatches(guest) ? instruction : word;
+        }
+        if (const auto instruction = NativeInventory::Instruction(pc, word); instruction != word) {
+            return MatchesTitle() && NativeInventory::CodeMatches(guest) ? instruction : word;
+        }
+        if (const auto instruction = TatlReminders::Instruction(pc, word); instruction != word) {
+            return MatchesTitle() && TatlReminders::CodeMatches(guest) ? instruction : word;
+        }
+        if (const auto instruction = Music::Instruction(pc, word); instruction != word) {
+            return MatchesTitle() && Music::CodeMatches(guest) ? instruction : word;
+        }
+        if (const auto instruction = MovementSpeed::Instruction(pc, word); instruction != word) {
+            return MatchesTitle() && MovementSpeed::CodeMatches(guest) ? instruction : word;
+        }
+        if (const auto instruction = CameraDistance::Instruction(pc, word); instruction != word) {
+            return MatchesTitle() && CameraDistance::CodeMatches(guest, pc) ? instruction : word;
+        }
+        if (const auto instruction = OptionsMenu::Instruction(pc, word); instruction != word) {
+            return MatchesTitle() && OptionsMenu::CodeMatches(guest) ? instruction : word;
+        }
+        if (pc == SongList::NavPC && word == SongList::NavWord) {
+            return MatchesTitle() && SongList::CodeMatches(guest) ? 0xef000000 | SongList::NavSVC : word;
+        }
+        if (const auto instruction = AzaharGameplay::Rewrite(guest, pc, word); instruction != word)
+            return MatchesTitle() ? instruction : word;
+        return word;
+    }
