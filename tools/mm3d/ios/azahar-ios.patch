+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+
+#include <algorithm>
+#include "citra_libretro/remasked_settings_bridge.h"
+#include "mm3d/bomber_approach.h"
+#include "mm3d/bottle_healing.h"
+#include "mm3d/classic_double_time.h"
+#include "mm3d/classic_save_hooks.h"
+#include "core/arm/fastinterp/remasked_classic_save.h"
+#include "mm3d/death_penalties.h"
+#include "mm3d/difficulty.h"
+#include "mm3d/fast_time.h"
+#include "mm3d/native_inventory.h"
+#include "mm3d/owl_sword.h"
+#include "mm3d/prices.h"
+
+namespace MM3D::AzaharGameplay {
+using U32 = std::uint32_t;
+inline std::atomic_bool single_screen{true};
+
+inline void Apply(const RemaskedGameplayOptions& options) {
+    BomberApproach::disabled = options.disableBomberApproach;
+    OwlIntro::disabled = OwlSword::enabled = options.swordActivateOwls;
+    ClassicDoubleTime::enabled = options.classicDoubleTime;
+    FastTime::enabled = options.fastTime;
+    ClassicSaving::enabled = options.classicSaving;
+    Difficulty::damage_multiplier = std::clamp(options.damageMultiplier, 1, 16);
+    Difficulty::weaker_enhanced_defense = options.weakerEnhancedDefense;
+    Difficulty::disable_heart_drops = options.disableHeartDrops;
+    Difficulty::disable_rupee_drops = options.disableRupeeDrops;
+    Difficulty::disable_fairy_drops = options.disableFairyDrops;
+    Difficulty::disable_magic_drops = options.disableMagicDrops;
+    Difficulty::disable_ammo_pickups = options.disableAmmoPickups;
+    DeathPenalties::lose_rupees = options.loseRupeesOnDeath;
+    DeathPenalties::world_ends = options.endWorldOnDeath;
+    DeathPenalties::advance_six_hours = options.advanceTimeOnDeath;
+    Prices::multiplier = options.doubleShopPrices ? 2u : 1u;
+    BottleHealing::red_hearts = std::clamp(options.redPotionHearts, 1, 20);
+    BottleHealing::blue_hearts = std::clamp(options.bluePotionHearts, 1, 20);
+    BottleHealing::fairy_hearts = std::clamp(options.bottledFairyHearts, 1, 20);
+}
+
+using Matcher = U32 (*)(U32, U32);
+
+// Price hooks share a range of SVCs. Find the site by guest PC without
+// scanning the shop table at every instruction decoded by FastInterp.
+inline constexpr auto PriceOrder = [] {
+    std::array<unsigned, Prices::Sites.size()> order{};
+    for (unsigned i = 0; i < order.size(); ++i) order[i] = i;
+    std::sort(order.begin(), order.end(), [](unsigned a, unsigned b) {
+        return Prices::Sites[a].pc < Prices::Sites[b].pc;
+    });
+    return order;
+}();
+
+inline U32 PriceInstruction(U32 pc, U32 word) {
+    const auto it = std::lower_bound(PriceOrder.begin(), PriceOrder.end(), pc,
+        [](unsigned index, U32 address) { return Prices::Sites[index].pc < address; });
+    if (it == PriceOrder.end() || Prices::Sites[*it].pc != pc || Prices::Sites[*it].word != word) return word;
+    return (word & 0xf0000000) | 0x0f000000 | (Prices::FirstSVC + *it);
+}
+
+inline constexpr std::array<Matcher, 11> Matchers{
+    BomberApproach::Instruction, BottleHealing::Instruction, Difficulty::Instruction,
+    Difficulty::SpawnInstruction, DeathPenalties::Instruction, OwlIntro::Instruction,
+    OwlSword::Instruction, ClassicSaving::Instruction, ClassicDoubleTime::Instruction,
+    FastTime::Instruction, PriceInstruction};
+
+inline constexpr U32 FirstSVC = ClassicSaving::FirstSVC;
+
+inline bool Handles(U32 svc) {
+    switch (svc) {
+    case Difficulty::SVC:
+    case Difficulty::DefenseSVC:
+    case Difficulty::SpawnSVC:
+    case DeathPenalties::SceneSoundSVC:
+    case SingleScreenText::SVC:
+        return true;
+    default:
+        return (svc >= ClassicSaving::FirstSVC && svc < ClassicSaving::FirstSVC + ClassicSaving::Sites.size()) ||
+               (svc >= BomberApproach::FirstSVC && svc <= BomberApproach::FirstSVC + 1) ||
+               (svc >= OwlIntro::FirstSVC && svc <= OwlIntro::FirstSVC + 1) ||
+               (svc >= OwlSword::FirstSVC && svc <= OwlSword::FirstSVC + 1) ||
+               (svc >= BottleHealing::FirstSVC && svc <= BottleHealing::FirstSVC + 2) ||
+               (svc >= DeathPenalties::FirstSVC && svc <= DeathPenalties::FirstSVC + 1) ||
+               (svc >= ClassicDoubleTime::FirstSVC && svc < ClassicDoubleTime::FirstSVC + ClassicDoubleTime::Sites.size()) ||
+               (svc >= FastTime::FirstSVC && svc < FastTime::FirstSVC + FastTime::Hooks.size()) ||
+               (svc >= Prices::FirstSVC && svc < Prices::FirstSVC + Prices::Sites.size());
+    }
+}
+
+template<class Memory> U32 Rewrite(Memory& memory, U32 pc, U32 word) {
+    for (unsigned i = 0; i < Matchers.size(); ++i) {
+        const U32 hook = Matchers[i](pc, word);
+        if (hook == word) continue;
+        switch (i) {
+        case 0: return BomberApproach::CodeMatches(memory) ? hook : word;
+        case 1: return BottleHealing::CodeMatches(memory) ? hook : word;
+        case 2: return Difficulty::CodeMatches(memory, pc) ? (word & 0xf0000000) | (hook & 0x0fffffff) : word;
+        case 3: return Difficulty::SpawnCodeMatches(memory, pc) ? hook : word;
+        case 4: return DeathPenalties::CodeMatches(memory) ? hook : word;
+        case 5: return OwlIntro::CodeMatches(memory) ? hook : word;
+        case 6: return OwlSword::CodeMatches(memory) ? hook : word;
+        case 7: return ClassicSaving::CodeMatches(memory) ? hook : word;
+        case 8: return ClassicDoubleTime::CodeMatches(memory) && SingleScreenText::CodeMatches(memory) ? hook : word;
+        case 9: return FastTime::CodeMatches(memory) ? hook : word;
+        case 10: return Prices::CodeMatches(memory) ? hook : word;
+        }
+    }
+    if (const U32 hook = SingleScreenText::Instruction(pc, word); hook != word && SingleScreenText::CodeMatches(memory))
+        return hook;
+    return word;
+}
+
+struct Hook {
+    ClassicDoubleTime::Hook doubleTime;
+    DeathPenalties::RespawnSound respawnSound;
+    ClassicSaving::Hook classicSave;
+
+    template<class Memory, class State> bool Run(Memory& memory, State& state, U32 pc, U32 word,
+                                                U32 svc, U32& nextPC) {
+        auto& r = state.regs;
+        const auto match = [&](Matcher instruction) {
+            const U32 hook = instruction(pc, word);
+            return hook != word && (hook & 0xffffff) == svc;
+        };
+        r[15] = nextPC;
+        switch (svc) {
+        case BomberApproach::FirstSVC:
+        case BomberApproach::FirstSVC + 1: {
+            if (!match(BomberApproach::Instruction)) return false;
+            const bool suppress = BomberApproach::Suppress(memory, r[4]);
+            if (svc == BomberApproach::FirstSVC) {
+                const auto actorState = static_cast<std::int16_t>(memory.memory.Read16(r[5] + 0x8c));
+                r[0] = BomberApproach::State(static_cast<U32>(actorState), suppress);
+            } else if (suppress) r[15] = BomberApproach::ResetPC;
+            else r[1] = 0xf;
+            break;
+        }
+        case BottleHealing::FirstSVC:
+        case BottleHealing::FirstSVC + 1:
+        case BottleHealing::FirstSVC + 2:
+            if (!match(BottleHealing::Instruction)) return false;
+            BottleHealing::Apply(memory, r, svc - BottleHealing::FirstSVC,
+                                 BottleHealing::red_hearts, BottleHealing::blue_hearts, BottleHealing::fairy_hearts);
+            break;
+        case Difficulty::DefenseSVC:
+        case Difficulty::SVC:
+            if (!match(Difficulty::Instruction)) return false;
+            if (svc == Difficulty::DefenseSVC)
+                r[4] = Difficulty::DefenseDelta(r[4], r[1], state.GetCPSR(), Difficulty::weaker_enhanced_defense);
+            else r[2] = Difficulty::ApplyDamage(r[2], r[4], Difficulty::damage_multiplier);
+            break;
+        case Difficulty::SpawnSVC:
+            if (!match(Difficulty::SpawnInstruction)) return false;
+            Difficulty::Spawn(memory, r, Difficulty::disable_heart_drops, Difficulty::disable_rupee_drops,
+                              Difficulty::disable_fairy_drops, Difficulty::disable_magic_drops,
+                              Difficulty::disable_ammo_pickups);
+            break;
+        case DeathPenalties::FirstSVC:
+        case DeathPenalties::FirstSVC + 1:
+        case DeathPenalties::SceneSoundSVC:
+            if (!match(DeathPenalties::Instruction)) return false;
+            if (svc == DeathPenalties::FirstSVC) DeathPenalties::Death(memory, r, DeathPenalties::lose_rupees);
+            else if (svc == DeathPenalties::FirstSVC + 1)
+                DeathPenalties::Continue(memory, r, DeathPenalties::world_ends, DeathPenalties::advance_six_hours, &respawnSound);
+            else respawnSound.SceneInit(memory, r);
+            break;
+        case OwlIntro::FirstSVC:
+        case OwlIntro::FirstSVC + 1:
+            if (!match(OwlIntro::Instruction)) return false;
+            if (svc == OwlIntro::FirstSVC) OwlIntro::Enter(r);
+            else r[0] = OwlIntro::TatlFlags(memory.memory.Read8(r[0] + 0x2d3));
+            break;
+        case OwlSword::FirstSVC:
+        case OwlSword::FirstSVC + 1:
+            if (!match(OwlSword::Instruction)) return false;
+            if (svc == OwlSword::FirstSVC) {
+                r[4] = r[0];
+                OwlSword::Update(memory, r[4]);
+                OwlSword::BlockFeatherAcceptance(memory, r[4], ClassicSaving::enabled);
+            } else if (OwlSword::Locked(memory, r[0]) ||
+                       OwlSword::FeatherBlocked(memory, r[0], ClassicSaving::enabled)) r[0] = 0;
+            else {
+                r[14] = OwlSword::OfferPC + 4;
+                r[15] = 0x3c322c;
+            }
+            break;
+        case SingleScreenText::SVC:
+            if (!match(SingleScreenText::Instruction)) return false;
+            doubleTime.Message(memory, r[0], r[1]);
+            SingleScreenText::Apply(memory, r[0], r[1], single_screen.load());
+            if (Prices::multiplier.load() != 1 && Prices::CodeMatches(memory))
+                Prices::Message(memory, r[0], r[1], Prices::multiplier);
+            r[3] = memory.memory.Read32(r[0] + 4);
+            break;
+        default:
+            if (svc >= ClassicSaving::FirstSVC && svc < ClassicSaving::FirstSVC + ClassicSaving::Sites.size()) {
+                if (!match(ClassicSaving::Instruction)) return false;
+                const unsigned site = svc - ClassicSaving::FirstSVC;
+                auto& saves = AzaharClassicSave::Saves;
+                if (site == 2) saves.Cancel();
+                const bool endWrite = site == 4 && r[4] == classicSave.writer;
+                classicSave.Handle(memory, r, site, saves);
+                if (endWrite && r[0] == 0) {
+                    saves.Cancel();
+                    if (classicSave.pending_quit) {
+                        // Use Azahar's native transition without the desktop renderer's fade handshake.
+                        classicSave.presentation.Reset(memory);
+                        classicSave.pending_frames = 20;
+                        ClassicSaving::exit_fade = ClassicSaving::ExitFade::Idle;
+                    }
+                }
+                if (site == 15 && r[15] == nextPC) r[1] = memory.Read(0x577b74).value_or(0);
+            } else if (svc >= ClassicDoubleTime::FirstSVC && svc < ClassicDoubleTime::FirstSVC + ClassicDoubleTime::Sites.size()) {
+                if (!match(ClassicDoubleTime::Instruction)) return false;
+                doubleTime.Handle(memory, r, svc - ClassicDoubleTime::FirstSVC);
+            } else if (svc >= FastTime::FirstSVC && svc < FastTime::FirstSVC + FastTime::Hooks.size()) {
+                if (!match(FastTime::Instruction)) return false;
+                FastTime::Update(memory, r, svc, FastTime::enabled);
+            } else if (svc >= Prices::FirstSVC && svc < Prices::FirstSVC + Prices::Sites.size()) {
+                if (!match(PriceInstruction)) return false;
+                Prices::Execute(memory, r, svc - Prices::FirstSVC, Prices::multiplier);
+            } else return false;
+        }
+        nextPC = r[15];
+        if (nextPC & 1) {
+            state.thumb_mode = true;
+            nextPC &= ~1u;
+        }
+        return true;
+    }
+};
+} // namespace MM3D::AzaharGameplay
