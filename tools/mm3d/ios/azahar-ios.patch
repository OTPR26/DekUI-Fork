+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include "mm3d/native_inventory.h"
+#include "core/arm/fastinterp/pause_navigation.h"
+
+namespace MM3D::IOSMenuPageSwitch {
+using NativeInventory::U32;
+using NativeInventory::Pointer;
+using NativeInventory::LayoutNamed;
+// Restoration + HD HUD v110 USA. Keep the screen manager's Prepare/Open/Close
+// calls and resource-ready checks; only this requested handoff skips animation.
+constexpr U32 FirstSVC=0xffff90;
+constexpr std::array<U32,8> PCs{0x104dd0,0x10fda4,0x161aec,0x5c27b8,0x5c2468,0x5a5ff4,0x5a5ef0,0x59730c};
+constexpr std::array<U32,8> Words{0xe1a04000,0xe12fff32,0xe1a04000,0xeaefe2d8,0x1bef58fd,0xebefca1a,0xeddf0a32,0xebf1a4f4};
+constexpr U32 ItemsVtable=0x639ec4,MasksVtable=0x639f74,GearVtable=0x63a270,MapVtable=0x639de4;
+constexpr std::array<std::pair<U32,U32>,23> Guards{{
+    {0x104dd8,0xeb002bad},{0x104e0c,0xe5912030},
+    {0x104e24,0xe591201c},{0x104e48,0xe5912020},
+    {0x10fda0,0xe1a01004},{0x10fda8,0xe5c40011},
+    {0x161ae8,0xe92d4030},{0x161af8,0xeeb09a40},
+    {ItemsVtable+0x1c,0x59e5c4},{ItemsVtable+0x20,0x59e864},
+    {GearVtable+0x1c,0x5a6158},{GearVtable+0x20,0x5a6b40},
+    {0x5c27b4,0xe2800010},{0x5a5ff8,0xe5940100},
+    {0x5a5ffc,0xe5c06186},{0x5c2464,0x12800010},{0x5a5fc0,0x3f000000},
+    {MasksVtable+0x1c,0x59f7c4},{MasksVtable+0x20,0x59fa80},
+    {MapVtable+0x1c,0x5975ac},{MapVtable+0x20,0x59937c},
+    {0x597304,0xe59f013c},{0x597310,0xe5970004}
+}};
+inline U32 Instruction(U32 pc,U32 word) {
+    for(unsigned i=0;i<PCs.size();++i)
+        if(pc==PCs[i]&&word==Words[i])return (word&0xf0000000)|0x0f000000|(FirstSVC+i);
+    return word;
+}
+template<class M> bool CodeMatches(M& m) {
+    for(unsigned i=0;i<PCs.size();++i)if(m.Read(PCs[i])!=Words[i])return false;
+    for(auto [at,word]:Guards)if(m.Read(at)!=word)return false;
+    return true;
+}
+template<class M> std::optional<U32> Byte(M& m,U32 at) {
+    auto w=m.Read(at&~3u);if(!w)return {};return (*w>>((at&3)*8))&255;
+}
+// Items/Masks capture conversion keeps one quarter of scene brightness.
+// Gear instead draws a black overlay; use 75% alpha for the same dimming.
+inline U32 GearBackdropAlpha() {
+    return std::bit_cast<U32>(GearMenu::enabled.load()?.75f:.5f);
+}
+constexpr U32 NotebookVtable=0x0063a3bc;
+template<class M> bool NotebookCodeMatches(M& m) {
+    // Constructor's vtable literal, PrepareOpen, Open and Calc, v1.1 USA.
+    return m.Read(0x005b49d0)==NotebookVtable &&
+           m.Read(NotebookVtable+0x1c)==0x005b4444 &&
+           m.Read(NotebookVtable+0x20)==0x005b475c &&
+           m.Read(NotebookVtable+0x24)==0x005b3ff8;
+}
+// Start is the Android pause-menu toggle. Let the native page handle its
+// normal Back action, including selection cleanup, sounds and close animation.
+// Never synthesize Back on title screens, modal details or a pending handoff.
+template<class M> bool StartBack(M& m,U32 ctx,bool& armed) {
+    if(!PauseNavigation::enabled.load() || !Pointer(ctx,20) || m.Read(ctx+12)!=0 ||
+       Byte(m,ctx+16)!=1 || Byte(m,ctx+17)!=1){armed=false;return false;}
+    const auto ui=m.Read(ctx+4),current=m.Read(ctx+8);
+    if(!ui || !current || !Pointer(*ui,0x170) || !Pointer(*current,0x198)){armed=false;return false;}
+    const auto game=m.Read(*ui+0x16c);
+    if(!game || !Pointer(*game,0x140) || Byte(m,*game+0x13d)!=4){armed=false;return false;}
+    const auto pressed=m.Read(*game+0x34),held=m.Read(*game+0x30);
+    if(!pressed || !held){armed=false;return false;}
+    const auto vtable=m.Read(*current);
+    bool ready=false;
+    if((m.Read(0x656b10)==current && vtable==ItemsVtable) ||
+       (m.Read(0x656b18)==current && vtable==MasksVtable)) {
+        const auto state=Byte(m,*current+0x9f);ready=state==2 || state==3;
+    } else if(m.Read(0x656b0c)==current && vtable==GearVtable)ready=Byte(m,*current+0x194)==2;
+    else if(m.Read(0x656b14)==current && vtable==MapVtable)ready=Byte(m,*current+0x78e)==0;
+    else if(m.Read(0x656b08)==current && vtable==NotebookVtable && NotebookCodeMatches(m))
+        ready=Byte(m,*current+0xc)==0;
+    if(!ready){armed=false;return false;}
+    // Opening can reach a ready page while its Start edge is still present.
+    // Require release inside the menu before a subsequent press may go Back.
+    if(!((*pressed|*held)&8u)){armed=true;return false;}
+    if(!armed || !(*pressed&8u))return false;
+    armed=false;
+    m.Write(*game+0x34,(*pressed&~8u)|2u); // replace only Start edge with B
+    return true;
+}
+struct Hook {
+    U32 context=0,source=0,target=0,target_vtable=0;
+    unsigned opening_ticks=0,waiting_ticks=0;
+    bool preserve_capture=false,start_back_armed=false;
+    template<class M> bool PairPending(M& m,U32 ctx) const {
+        return context&&ctx==context&&m.Read(ctx+8)==source&&m.Read(ctx+12)==target;
+    }
+    template<class M,class Registers> void MapCloseSound(M& m,Registers& r) const {
+        // Map's Close unconditionally plays the exit sound. A bumper handoff
+        // is still inside the menu; keep the native sound for real exits.
+        const bool page_switch=PairPending(m,context)&&target_vtable==ItemsVtable&&
+            m.Read(source)==MapVtable&&m.Read(target)==ItemsVtable;
+        r[14]=PCs[7]+4;
+        r[15]=page_switch?r[14]:0x2006e4;
+    }
+    template<class M> bool KeepCapture(M& m,U32 capture) const {
+        if(!preserve_capture||!PairPending(m,context))return false;
+        auto ui=m.Read(context+4);
+        if(!ui||!Pointer(*ui,0x170))return false;
+        auto game=m.Read(*ui+0x16c);
+        return game&&Pointer(*game,0x11030)&&Byte(m,*game+0x13d)==4&&capture==*game+0x11010;
+    }
+    // Replay the original branches when no page handoff owns this capture.
+    // Gear also clears a byte on its graphics owner after Close. Preserve that
+    // byte only if the owner is the shared capture state; otherwise replay it.
+    template<class M,class Registers> void CaptureCall(M& m,Registers& r,unsigned site) const {
+        const bool keep=KeepCapture(m,r[0]);
+        if(site==3) {r[15]=keep?r[14]:0x1bb320;return;} // tail B: preserve LR
+        r[14]=PCs[site]+4;
+        r[15]=keep?r[14]:0x198864;
+        if(keep&&site==5) {
+            auto owner=m.Read((r[0]-0x11010)+0x100),state=m.Read(0x66889c);
+            if(owner&&state&&Pointer(*owner,0x188)&&*owner==*state)r[15]=0x5a6000;
+        }
+    }
+    template<class M> void Tick(M& m,U32 ctx,bool retained_gear_scene=false,bool native_lower_input=false) {
+        if(context) {
+            if(ctx!=context||++waiting_ticks>120) {*this={};return;}
+            if(PairPending(m,ctx))return;
+            if(m.Read(ctx+8)==target&&m.Read(ctx+12)==0&&opening_ticks) {
+                --opening_ticks;return;
+            }
+            *this={};
+        }
+        if(StartBack(m,ctx,start_back_armed))return;
+        if(!NativeInventory::enabled.load()||!GearMenu::enabled.load()||!Pointer(ctx,20)||
+           m.Read(ctx+12)!=0||Byte(m,ctx+16)!=1||Byte(m,ctx+17)!=1)return;
+        auto current=m.Read(ctx+8),ui=m.Read(ctx+4);
+        if(!current||!ui||!Pointer(*ui,0x170))return;
+        auto game=m.Read(*ui+0x16c);
+        if(!game||!Pointer(*game,0x140)||Byte(m,*game+0x13d)!=4)return;
+        auto pressed=m.Read(*game+0x34),items=m.Read(0x656b10),gear=m.Read(0x656b0c),
+             masks=m.Read(0x656b18),map=m.Read(0x656b14),notebook=m.Read(0x656b08);
+        if(!pressed||!items||!gear||!masks||!map||
+           !Pointer(*items,0xc4)||!Pointer(*masks,0xc4)||!Pointer(*gear,0x198)||!Pointer(*map,0x794)||
+           m.Read(*items)!=ItemsVtable||m.Read(*masks)!=MasksVtable||
+           m.Read(*gear)!=GearVtable||m.Read(*map)!=MapVtable)return;
+        // Gear <- Masks <-> Items -> Map -> Notebook. The middle pair remains native.
+        if(*pressed&0xc0f)return;
+        const U32 shoulder=*pressed&0x300;
+        if(native_lower_input&&shoulder&&(*current==*items||*current==*masks)) {
+            // Native lower tabs synthesize a shoulder edge on release. They
+            // request the opposite inventory page, never an outer Gear/Map tab.
+            // Actual host shoulders retain the custom controller ordering below.
+            const auto state=Byte(m,*current+0x9f);
+            const bool from_items=*current==*items;
+            auto layout=m.Read(*current+0xc0);
+            if((state!=2&&state!=3)||!layout||!LayoutNamed(m,*layout,from_items?"MenuItem":"MenuMask"))return;
+            target=from_items?*masks:*items;
+            target_vtable=from_items?MasksVtable:ItemsVtable;
+        } else if((*current==*items&&shoulder==0x100)||(*current==*masks&&shoulder==0x200)) {
+            // Native inventory accepts shoulders in both browsing (2) and
+            // selected-item (3) states. Otherwise selection falls through to
+            // its original two-page toggle instead of our outer-page route.
+            const auto state=Byte(m,*current+0x9f);
+            if(state!=2&&state!=3)return;
+            auto layout=m.Read(*current+0xc0);
+            const bool from_items=*current==*items;
+            if(!layout||!LayoutNamed(m,*layout,from_items?"MenuItem":"MenuMask"))return;
+            if(from_items) {
+                auto mode=m.Read(*map+0x78c);if(!mode)return;
+                // Same reset as Restoration's map shortcut: never reopen Soaring.
+                m.Write(*map+0x78c,*mode&~0x00ff0000u);
+                target=*map;target_vtable=MapVtable;
+            } else {target=*gear;target_vtable=GearVtable;}
+        } else if(*current==*gear&&shoulder==0x100) {
+            const auto state=Byte(m,*gear+0x194);
+            // A retained scene makes the photo's load/open wait irrelevant to
+            // tab navigation. The native destructor cancels an unfinished photo.
+            if(state!=2&&!(retained_gear_scene&&(state==0||state==1)))return;
+            auto layout=m.Read(*gear+0x14);
+            if(!layout||!LayoutNamed(m,*layout,"MenuCollect"))return;
+            target=*masks;target_vtable=MasksVtable;
+        } else if(PauseNavigation::enabled.load()&&
+                  ((*current==*map&&shoulder==0x100)||
+                   (notebook&&*current==*notebook&&shoulder==0x200))) {
+            if(!notebook||!Pointer(*notebook,0x7b0)||
+               m.Read(*notebook)!=NotebookVtable||!NotebookCodeMatches(m))return;
+            if(*current==*map&&shoulder==0x100) {
+                auto collect=m.Read(0x7751d8+0x1f8);
+                auto layout=m.Read(*map+0x18);
+                if(!collect||!PauseNavigation::NotebookUnlocked(*collect)||
+                   Byte(m,*map+0x78e)!=0||!layout||
+                   !LayoutNamed(m,*layout,"MenuMapDungeon"))return;
+                target=*notebook;target_vtable=NotebookVtable;
+            } else if(*current==*notebook&&shoulder==0x200) {
+                // Keep schedule/detail navigation native; leave from the main
+                // Event Notes page only, when its layout is ready.
+                auto layout=m.Read(*notebook+0x40);
+                if(Byte(m,*notebook+0xc)!=0||!layout||
+                   !LayoutNamed(m,*layout,"MenuQuestlist"))return;
+                auto mode=m.Read(*map+0x78c);if(!mode)return;
+                m.Write(*map+0x78c,*mode&~0x00ff0000u);
+                target=*map;target_vtable=MapVtable;
+            } else return;
+        } else if(*current==*map&&shoulder==0x200) {
+            if(Byte(m,*map+0x78e)!=0)return;
+            auto layout=m.Read(*map+0x18);
+            if(!layout||!LayoutNamed(m,*layout,"MenuMapDungeon"))return;
+            target=*items;target_vtable=ItemsVtable;
+        } else return;
+        if(target_vtable==NotebookVtable||(notebook&&*current==*notebook)) {
+            // Notebook owns a different set of resources. Use the ordinary
+            // screen-manager transition, including asynchronous readiness and
+            // its own capture lifetime, rather than inventory's fast handoff.
+            m.Write(ctx+12,target);
+            m.Write(*game+0x34,*pressed&~shoulder);
+            *this={};return;
+        }
+        // A map opened independently may not own an inventory capture. In that
+        // case allow native Items PrepareOpen to create one normally.
+        auto capture=m.Read(*game+0x11018);
+        preserve_capture=(capture&&Pointer(*capture,0xb0))||(*current==*gear&&retained_gear_scene);
+        context=ctx;source=*current;opening_ticks=1;waiting_ticks=0;
+        m.Write(ctx+12,target);
+        m.Write(*game+0x34,*pressed&~shoulder); // consume only this pressed edge
+    }
+    template<class M> void FinishMapBackground(M& m,U32 layout) const {
+        if(Byte(m,target+0x78d)!=0||Byte(m,target+0x78e)!=0||
+           !LayoutNamed(m,layout,"BackGround"))return;
+        // BackGround is shared with gameplay. Direct menu entry must select
