+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include "mm3d/player_hud.h"
+#include "citra_libretro/remasked_touch_bridge.h"
+
+namespace MM3D {
+
+// Match Android's measured regular-HUD margins in Azahar's 400x240
+// picture. Touch item artwork keeps the exact UIKit anchors.
+struct RemaskedHudDraw {
+    PlayerHud::Hook helper;
+    using Write = PlayerHud::Hook::Write;
+    std::vector<std::vector<Write>> frames;
+
+    template<class Memory> void Begin(Memory& m, u32 layout, bool touch, bool airPlayTop = false) {
+        using namespace NativeInventory;
+        frames.emplace_back();
+        if (!LayoutNamed(m, layout, "Hud") && !LayoutNamed(m, layout, "Hud2") &&
+            !LayoutNamed(m, layout, "HudItemIconSet")) return;
+
+        std::vector<Write> unused;
+        std::vector<u32> nodes, seen;
+        if (!helper.helper.Transform(m, layout + 8, unused, nodes, {1, 0, 0, 1, 0, 0})) return;
+        auto find = [&](const char* name) {
+            const auto it = std::find_if(nodes.begin(), nodes.end(), [&](u32 n) { return Named(m, n, name); });
+            return it == nodes.end() ? 0u : *it;
+        };
+
+        auto& writes = frames.back();
+        // The display-X clip correction adds space evenly around the 400 px
+        // guest canvas. Keep ordinary HUD margins relative to the new edges.
+        const float side = 200.f * (RemaskedPictureAspect.load() / RemaskedNativeAspect - 1.f);
+        const float left = side - RemaskedPictureLeftInset.load();
+        const float right = side - RemaskedPictureRightInset.load();
+        const auto shift = [&](std::initializer_list<const char*> group,
+                               float offset_x = 0, float offset_y = 0,
+                               bool anchor = false, bool from_right = false) {
+            PlayerHud::Bounds bounds;
+            for (const char* name : group) {
+                const u32 node = find(name);
+                PlayerHud::Bounds part;
+                if (node && helper.Measure(m, node, part, true)) bounds.Add(part);
+            }
+            if (!bounds.Valid() || bounds.right - bounds.left > 165.f) return;
+            if (anchor) {
+                offset_x -= from_right ? bounds.right : bounds.left;
+                offset_y -= bounds.top;
+            }
+            const float minimum = 4.f - left - bounds.left, maximum = 396.f + right - bounds.right;
+            if (minimum > maximum) return;
+            const float dx = std::clamp(offset_x, minimum, maximum);
+            if (dx == 0 && offset_y == 0) return;
+            for (const char* name : group) {
+                const u32 node = find(name);
+                if (node) helper.helper.Transform(m, node, writes, seen, {1, 0, 0, 1, dx, offset_y});
+            }
+        };
+        shift({"heart_status"}, (touch ? 0.f : 8.8f) - left);
+        shift({"rupee_g", "key_g"}, -left);
+        if (touch) {
+            shift({"magic_gauge_g"}, -left);
+        } else {
+            const u32 gauge = find("magic_gauge_g");
+            const u32 base = find("gauge_base");
+            PlayerHud::Bounds bounds;
+            if (gauge && base && helper.Measure(m, base, bounds, true)) {
+                const float width = bounds.right - bounds.left, height = bounds.bottom - bounds.top;
+                if (width > 35 && width < 145 && height > 2 && height < 20) {
+                    const float size = HudAdjustments::Scale(HudAdjustments::Magic);
+                    const auto part = HudAdjustments::Magic;
+                    const float sx = 71.7f * size / width;
+                    const float sy = 4.0f * size * HudAdjustments::Factor(HudAdjustments::magic_height_steps.load()) / height;
+                    helper.helper.Transform(m, gauge, writes, seen,
+                        {sx, 0, 0, sy, 13.6f - left + HudAdjustments::X(part) - bounds.left * sx,
+                         21.6f + HudAdjustments::Y(part) - bounds.top * sy});
+                }
+            }
+            shift({"hud_dpad", "chat_alart"}, -left, airPlayTop ? 37.f : 6.f);
+            if (airPlayTop) {
+                // Use the approved phone HUD's native-coordinate anchors.
+                // L sits below the magic bar, while R sits above the face buttons.
+                shift({"icon_item_1_g", "btn_corner01_g"}, 10.f - left, 34.f, true);
+                shift({"icon_item_2_g", "btn_corner03_g"}, 390.f + right, 6.f, true, true);
+            } else {
+                shift({"icon_item_1_g", "btn_corner01_g"}, 7.2f - left, 3.7f);
+                shift({"icon_item_2_g", "btn_corner03_g"}, right);
+            }
+            const float face_y = airPlayTop ? 24.f : 0.f;
+            shift({"a_action_button", "b_action_button"}, right - 11.2f, face_y);
+            shift({"icon_item_x_g", "btn_x_g", "icon_item_y_g", "btn_y_g"}, right - 11.2f, face_y);
+        }
+
+        // X/Y and I/II share the atlas with the item previews but have
+        // their own text panes. Leave the artwork and quantity overlays.
+        for (const char* name : {"disp_x_pane", "disp_y_pane", "disp_1_pane", "disp_2_pane"}) {
+            const u32 node = find(name);
+            if (node) helper.helper.Transform(m, node, writes, seen, {0, 0, 0, 0, 0, 0});
+        }
+        for (const auto& write : writes) m.Write(write.address, write.after);
+    }
+
+    template<class Memory> void End(Memory& m) {
+        if (frames.empty()) return;
+        for (auto it = frames.back().rbegin(); it != frames.back().rend(); ++it)
+            m.Write(it->address, it->before);
+        frames.pop_back();
+    }
+};
+}
