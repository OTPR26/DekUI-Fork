+                break;
+            }
+            if (auto sp = file_prompt.End(guest)) {
+                regs[13] = sp;
+            }
+            pause.End(guest, dungeon_map, regs[13]);
+            if (auto sp = songs.shadow_scratch.End(guest)) regs[13] = sp;
+            if (auto sp = ocarina.End(guest)) regs[13] = sp;
+            if (auto sp = notebook.prompt_hook.End(guest)) regs[13] = sp;
+            neutral_hud.End(guest);
+            touch_hud.End(guest);
+            options.End(guest);
+            file_select.End(guest);
+            press_start.End(guest);
+            loading_icon.End(guest);
+            notebook.End(guest);
+            inventory.End(guest);
+            songs.End(guest);
+            dungeon_map.End(guest);
+            hud_buttons.End(guest);
+            pause.present.End(guest);
+            guest.Write(regs[6], regs[0]);
+            break;
+        case DialogueScale::BeforeSVC: {
+            const u32 layout = regs[4];
+            if (dual) {
+                regs[0] = layout + 8;
+                break;
+            }
+            const bool description = item_preview.Description(guest, layout);
+            const bool map_description = dungeon_map.IsDescription(guest, layout);
+            const bool options_description = options.IsDescription(guest, layout);
+            const auto& map = DungeonMap::poses[DungeonMap::Description];
+            const GearMenu::Pose map_pose{map.x.load(), map.y.load(), map.scale.load()};
+            const auto& item = (pause.present.mask_menu ? NativeItemPresent::mask_poses :
+                NativeItemPresent::poses)[NativeItemPresent::Description];
+            const GearMenu::Pose item_pose{item.x.load(), item.y.load(), item.scale.load()};
+            const bool present_description = pause.present.IsDescription(guest, layout);
+            if (present_description) pause.select_help.source.description = layout;
+            pause.dialogue.Begin(guest, layout, description, description && item_preview.gear,
+                options_description ? &options.frame.description :
+                map_description ? &map_pose : present_description ? &item_pose : nullptr);
+            pause.present.BeginPromptPose(guest, layout);
+            regs[0] = layout + 8;
+            break;
+        }
+        case DialogueScale::AfterSVC:
+            if (!dual) {
+                pause.present.EndPromptPose(guest);
+                pause.dialogue.End(guest, regs[4]);
+            }
+            regs[13] += 8;
+            break;
+        case OptionsMenu::DrawSVC:
+            options.Capture(guest, regs[0]);
+            regs[4] = regs[0];
+            break;
+        case OptionsMenu::SelectSVC:
+            regs[2] = OptionsMenu::Selection(guest, regs[0], regs[2]);
+            regs[4] = regs[0];
+            break;
+        default:
+            return false;
+        }
+        return true;
+    }
+
+private:
+    static constexpr u32 ShortcutPC = 0x7d0684, ShortcutWord = 0xe5942034, ShortcutSVC = 0xffffc3;
+    static_assert(ShortcutSVC > MM3D::InventoryNavigation::FirstSVC + 2);
+    static constexpr u32 ItemShoulderPC = 0x7cfbc4, ItemShoulderWord = 0xe3130901;
+    static constexpr u32 ItemShoulderSVC = 0xffffc4, ItemShoulderCopyBackPC = 0x7cfbf0;
+    static_assert(ItemShoulderSVC > ShortcutSVC);
+
+    bool ItemShoulderCodeMatches() {
+        constexpr std::array<std::pair<u32, u32>, 10> guards{{
+            {0x878434, 0xebfd5ddb}, {0x7cfba8, 0xe92d4070}, {0x7cfbb4, 0xe59f51c4},
+            {0x7cfbc0, 0xe1c520b0}, {ItemShoulderPC, ItemShoulderWord}, {0x7cfbe8, 0xe3130902},
+            {0x7cfbec, 0x1a00002e}, {ItemShoulderCopyBackPC, 0xe1d530b0},
+            {0x7cfbf4, 0xe1c43ebd}, {0x7cfd80, 0x007f80fc}}};
+        return std::all_of(guards.begin(), guards.end(),
+                           [this](auto guard) { return guest.Read(guard.first) == guard.second; });
+    }
+
+    bool ShortcutCodeMatches() {
+        constexpr std::array<std::pair<u32, u32>, 7> guards{{
+            {0x7d0660, 0xe92d41f0}, {0x7d0674, 0xe5d4013d}, {ShortcutPC, ShortcutWord},
+            {0x7d0688, 0xe2133902}, {0x7d0698, 0xe2127008},
+            {0x7d06ac, 0xe1120003}, {0x7d0728, 0xe3a00002}}};
+        return std::all_of(guards.begin(), guards.end(),
+                           [this](auto guard) { return guest.Read(guard.first) == guard.second; });
+    }
+
+    void BeginTouchHud(u32 layout) {
+        touch_hud.Begin(guest, layout);
+    }
+
+    bool MatchesTitle() const {
+        const auto process = system.Kernel().GetCurrentProcess();
+        return process && process->codeset && MM3D::RomRegion::UsesRemaskedPresentation(process->codeset->program_id);
+    }
+
+    Core::System& system;
+    struct GuestMemory {
+        Memory::MemorySystem& memory;
+        std::optional<u32> Read(u32 address) { return memory.Probe32(address); }
+        void Write(u32 address, u32 value) { memory.Write32(address, value); }
+    } guest;
+    MM3D::NativeStartup::Hook title;
+    MM3D::AzaharGameplay::Hook gameplay;
+    MM3D::NativeStartup::PressHook press_start;
+    MM3D::NativeStartup::LoadingIconHook loading_icon;
+    MM3D::NativeFileSelect::Hook file_select;
+    MM3D::OptionsMenu::Hook options;
+    MM3D::FileSelectPrompt::Hook file_prompt;
+    MM3D::PlayerHud::Hook touch_hud;
+    MM3D::IOSMenuPageSwitch::Hook page_switch;
+    MM3D::NativeInventory::Hook inventory;
+    MM3D::DungeonMap::Hook dungeon_map;
+    MM3D::SongList::Hook songs;
+    MM3D::OcarinaPrompt::Hook ocarina;
+    MM3D::NativeNotebook::Hook notebook;
+    MM3D::ItemPreview::Hook item_preview;
+    MM3D::HudButtons::Hook hud_buttons;
+    MM3D::RemaskedHudDraw neutral_hud;
+    u32 dual_draw_pass = 0;
+    RemaskedPauseDraw pause;
+};
