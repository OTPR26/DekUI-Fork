+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+
+#include "mm3d/classic_saving.h"
+#include <algorithm>
+#include <array>
+#include <cstdio>
+#include <filesystem>
+#include <fstream>
+#include <mutex>
+#include <optional>
+#include <vector>
+
+namespace MM3D::AzaharClassicSave {
+namespace fs = std::filesystem;
+using ClassicSaving::Kind;
+using Bytes = std::vector<std::uint8_t>;
+inline constexpr size_t SnapshotSize = 0x13618;
+inline constexpr std::string_view Archive = "/title/00040000/00125500/data/00000001/save";
+
+inline bool Valid(std::span<const std::uint8_t> bytes, Kind kind) {
+    if (bytes.size() != SnapshotSize || bytes[0] != 'M' || bytes[1] != 'J' ||
+        bytes[2] != 'R' || bytes[3] != 8 || (bytes[0x351e] != 0) != (kind == Kind::Owl))
+        return false;
+    unsigned crc = 0x1017;
+    for (size_t i = 0; i < bytes.size(); ++i) {
+        crc ^= i == 0x1a88 || i == 0x1a89 ? 0 : bytes[i];
+        for (unsigned bit = 0; bit < 8; ++bit) crc = (crc >> 1) ^ ((crc & 1) ? 0xa001 : 0);
+    }
+    return crc == (unsigned(bytes[0x1a88]) | unsigned(bytes[0x1a89]) << 8);
+}
+
+inline Bytes Read(const fs::path& path) {
+    std::ifstream input(path, std::ios::binary | std::ios::ate);
+    if (input.tellg() != SnapshotSize) return {};
+    Bytes result(SnapshotSize);
+    input.seekg(0);
+    if (!input.read(reinterpret_cast<char*>(result.data()), result.size())) return {};
+    return result;
+}
+
+inline fs::path Sidecar(const fs::path& native, std::string_view suffix) {
+    return native.parent_path() / ".classic-saving" / (native.filename().string() + std::string(suffix));
+}
+
+class Service {
+public:
+    // Empty optional denies the archive operation. The normal path remains
+    // the permanent snapshot even while an owl save is available.
+    std::optional<std::string> Open(const std::string& path, bool write) {
+        const auto index = path.rfind(Archive);
+        if (index == std::string::npos || index + Archive.size() + 5 != path.size() ||
+            !path.ends_with(".bin")) return path;
+        const auto slot = unsigned(path[index + Archive.size()] - '0');
+        if (slot >= native.size()) return path;
+        std::scoped_lock lock(mutex);
+        native[slot] = path;
+        if (!ClassicSaving::enabled) return path;
+        if (active == slot) {
+            if (!prepared) return std::nullopt;
+            return Sidecar(path, ".writing").string();
+        }
+        if (!write && Pending(path)) return Sidecar(path, ".owl").string();
+        return path;
+    }
+
+    bool Begin(unsigned slot, Kind kind) {
+        std::scoped_lock lock(mutex);
+        active = slot;
+        prepared = false;
+        if (slot >= native.size() || native[slot].empty()) return false;
+        const auto& path = native[slot];
+        if (kind == Kind::Owl && !MatchesCycle(path)) return false;
+        const auto staging = Sidecar(path, ".writing");
+        std::error_code error;
+        fs::create_directories(staging.parent_path(), error);
+        if (error) return false;
+        fs::copy_file(path, staging, fs::copy_options::overwrite_existing, error);
+        if (error) return false;
+        return prepared = true;
+    }
+
+    bool Finish(unsigned slot, Kind kind) {
+        std::scoped_lock lock(mutex);
+        const bool commit = active == slot && prepared;
+        active = native.size();
+        prepared = false;
+        if (!commit) return false;
+        const auto& path = native[slot];
+        const auto staging = Sidecar(path, ".writing");
+        if (!Valid(Read(staging), kind)) return false;
+        if (kind == Kind::Owl) {
+            return MatchesCycle(path) && std::rename(staging.c_str(), Sidecar(path, ".owl").c_str()) == 0;
+        }
+
+        // Publish the cycle receipt first. A crash here leaves the previous
+        // native save intact. A mismatched receipt can never activate an owl.
+        std::error_code error;
+        fs::copy_file(staging, Sidecar(path, ".cycle-next"), fs::copy_options::overwrite_existing, error);
+        if (error || std::rename(Sidecar(path, ".cycle-next").c_str(), Sidecar(path, ".cycle").c_str()) != 0)
+            return false;
+        fs::remove(Sidecar(path, ".owl"), error);
+        return !error && std::rename(staging.c_str(), path.c_str()) == 0;
+    }
+
+    void Cancel() {
+        std::scoped_lock lock(mutex);
+        active = native.size();
+        prepared = false;
+    }
+
+    void Reset() {
+        std::scoped_lock lock(mutex);
+        native = {};
+        active = native.size();
+        prepared = false;
+    }
+
+    void Load(unsigned slot, std::span<const std::uint8_t> loaded) {
+        std::scoped_lock lock(mutex);
+        ClassicSaving::resume_notice = false;
+        if (slot >= native.size() || !Pending(native[slot])) return;
+        const auto owl = Sidecar(native[slot], ".owl");
+        const auto bytes = Read(owl);
+        if (!std::ranges::equal(loaded, bytes)) return;
+        std::error_code error;
+        // Consumption does not write the permanent slot. On I/O failure the
+        // owl remains available instead of risking the last cycle save.
+        fs::remove(owl, error);
+    }
+
+private:
+    static bool MatchesCycle(const fs::path& path) {
+        const auto permanent = Read(path);
+        return Valid(permanent, Kind::Cycle) && permanent == Read(Sidecar(path, ".cycle"));
+    }
+
+    static bool Pending(const fs::path& path) {
+        std::error_code error;
+        return !path.empty() && fs::exists(Sidecar(path, ".owl"), error) &&
+               MatchesCycle(path) && Valid(Read(Sidecar(path, ".owl")), Kind::Owl);
+    }
+
+    std::mutex mutex;
+    std::array<fs::path, 3> native;
+    unsigned active = native.size();
+    bool prepared = false;
+};
+
+inline Service Saves;
+} // namespace MM3D::AzaharClassicSave
