+        // on each side. Fit that coordinate range inside Azahar's 400 px.
+        std::vector<Write> writes;
+        std::vector<u32> seen;
+        if (!inventory.Transform(memory, root, writes, seen, {.9375f, 0, 0, 1, 12.5f, 0})) return;
+        if (inventoryOpen && (LayoutNamed(memory, layout, "MenuItem") ||
+                              LayoutNamed(memory, layout, "MenuMask")))
+            UpdateItemSlotLabels(memory, inventory, seen, writes);
+        for (const auto& write : writes) memory.Write(write.address, write.after);
+        fit_frames.back() = std::move(writes);
+    }
+};
