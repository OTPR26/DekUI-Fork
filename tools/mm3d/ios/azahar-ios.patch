+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+
+#include "citra_libretro/remasked_touch_bridge.h"
+#include "core/arm/fastinterp/remasked_picture_draws.h"
+#include "mm3d/widescreen.h"
+
+namespace MM3D::AzaharPicture {
+
+template<class Registers, class VertexShader>
+float ClipScale(const Registers& regs, VertexShader& vertex, bool depthWrite) {
+    const float aspect = RemaskedPictureAspect.load();
+    const auto viewport = regs.rasterizer.GetViewportRect();
+    if (aspect <= RemaskedNativeAspect ||
+        !Widescreen::IsTopViewport(viewport.GetWidth(), viewport.GetHeight()))
+        return 1.f;
+
+    // Fullscreen fades and mask effects span the expanded frame. Apply the
+    // donor's layout-pane exception so ordinary widgets keep their shape.
+    if (!depthWrite && regs.pipeline.num_vertices <= 24) {
+        const auto& textures = regs.texturing.main_config;
+        const auto& merger = regs.framebuffer.output_merger;
+        const WidescreenProbe::Draw draw{
+            vertex.GetProgramCodeHash(), vertex.GetSwizzleDataHash(),
+            u32(regs.pipeline.num_vertices), unsigned(viewport.GetWidth()), unsigned(viewport.GetHeight()),
+            unsigned(textures.texture0_enable) | (unsigned(textures.texture1_enable) << 1) |
+                (unsigned(textures.texture2_enable) << 2),
+            unsigned(merger.alpha_blending.factor_source_rgb.Value()) |
+                (unsigned(merger.alpha_blending.factor_dest_rgb.Value()) << 4) |
+                (unsigned(merger.alpha_blending.blend_equation_rgb.Value()) << 8) |
+                (unsigned(merger.alphablend_enable) << 16),
+            u32(merger.depth_color_mask)};
+        if (draw == WidescreenProbe::TransitionOverlay ||
+            std::find(FullscreenDraws.begin(), FullscreenDraws.end(), draw) != FullscreenDraws.end()) {
+            const auto row = [&](unsigned index) {
+                std::array<float, 4> result{};
+                for (unsigned component = 0; component < result.size(); ++component)
+                    result[component] = vertex.uniforms.f[index][component].ToFloat32();
+                return result;
+            };
+            if (!WidescreenProbe::LocalLayoutPane(draw.shader, draw.swizzle, draw.vertices,
+                                                   draw.textures, row(10), row(11), row(12)))
+                return 1.f;
+        }
+    }
+    return RemaskedNativeAspect / aspect;
+}
+}
